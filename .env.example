# Copy to web/.env.local and services/api/.env, then fill in.
# Never commit a filled copy — this repository is public.

# ---------------------------------------------------------------- database ---
# Local development uses Homebrew Postgres 17 with pgvector (no Docker on the
# build machine, so `supabase start` is unavailable).
DATABASE_URL=postgres://localhost:5432/loupe_dev

# ------------------------------------------------------------------- auth ----
# From the Supabase dashboard: Project Settings → API.
# Until both are set, the app runs and says sign-in is unavailable rather than
# crashing — see web/src/lib/supabase/config.ts.
NEXT_PUBLIC_SUPABASE_URL=

# The browser-safe key, under either of its two names. Supabase renamed it:
# older projects issue an `anon` JWT, newer ones issue `sb_publishable_...`.
# Same thing, same position; set whichever your dashboard shows.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The secret key — `service_role` on older projects, `sb_secret_...` on newer
# ones. This project never uses it, and it is listed only so the name is
# recognisable: it must never be prefixed with NEXT_PUBLIC_, which would ship
# full database access to every visitor.
SUPABASE_SERVICE_ROLE_KEY=

# The API verifies Supabase access tokens locally with this, so a history write
# every ten seconds costs no network round-trip. Project Settings → API → JWT.
SUPABASE_JWT_SECRET=

# Base URL of the core API, read by the browser. Empty disables the features
# that need it rather than breaking the page.
NEXT_PUBLIC_API_URL=

# ------------------------------------------------------------------- api -----
ENVIRONMENT=local

# §10.3: the transcription cost ceiling, enforced by code rather than discipline.
TRANSCRIPTION_MINUTES_CAP=3000

# §4.2: the ingest worker fails closed when the day's units are gone.
INGEST_DAILY_QUOTA_UNITS=10000

# ------------------------------------------------------- media (Phase 1) -----
# Bunny Stream — decided in docs/adr/0001-media-provider.md.
# Read only by services/media, which is the sole holder of provider credentials
# (§5). Nothing else in the system ever sees these.
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_PULL_ZONE=
# Signs playback URLs. Separate from the API key on purpose: one signs
# management calls, the other signs what the public fetches.
BUNNY_TOKEN_KEY=

# Bunny does not sign Stream webhooks, so the endpoint sits behind an
# unguessable path segment. Generate with: openssl rand -hex 32
WEBHOOK_SECRET=

# --------------------------------------------------------- ai (Phase 6) ------
GEMINI_API_KEY=
GROQ_API_KEY=

# ---------------------------------------------------- ingest (Phase 4) -------
# Empty selects the fixture provider. §4.2 rule 1 permits only the nightly
# batch to call a third-party API, and never its search endpoint.
YOUTUBE_API_KEY=

# Far below the real 10,000/day, so a runaway loop hits our ceiling first.
DAILY_QUOTA_UNITS=2000
MAX_PAGES_PER_CHANNEL=2
